{
  "name": "weekly-planner-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap": "cap",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android",
    "cap:ios": "npm run build && cap sync ios",
    "desktop:dev": "npm run build && electron electron/main.cjs",
    "desktop:dist": "npm run build && electron-builder --config electron-builder.config.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/electron": "^2.5.0",
    "@capacitor/ios": "^8.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.framefrqnc.weeklyplanner.desktop",
    "productName": "Weekly Planner",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    }
  }
}
