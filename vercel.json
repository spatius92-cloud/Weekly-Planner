{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/((?!api/).*)", "destination": "/public/$1" }
  ],
  "crons": [
    { "path": "/api/cron/daily-digest", "schedule": "0 8 * * *" },
    { "path": "/api/cron/weekly-digest", "schedule": "0 8 * * 1" }
  ]
}
