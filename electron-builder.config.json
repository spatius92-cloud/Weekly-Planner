{
  "appId": "com.framefrqnc.weeklyplanner.desktop",
  "productName": "Weekly Planner",
  "icon": "resources/icon.png",
  "files": [
    "public/**/*",
    "electron/**/*",
    "server.js",
    "lib/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "data/db.json",
      "to": "seed-db.json"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "Weekly-Planner-Setup-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Weekly Planner"
  },
  "directories": {
    "output": "release"
  }
}
